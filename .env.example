# Server deployment from GHCR (Docker Compose v2+, Linux amd64).
# First run: python3 deploy/configure.py
# Recommended: edit deploy/local/deployment.env and use --env-file with every command.
# Alternative: copy this file to .env AFTER generating the password files, then
# omit --env-file. Explicit --env-file does not also load the root .env.
# Never put database passwords, web passwords, or model API keys in this file.

NOVEL_WRITER_STACK=novel-writer-server
# Root docker-compose.yml: use a sha-<commit> tag or digest to pin a release.
NOVEL_WRITER_IMAGE=ghcr.io/ghost-soul/xs-agent:latest

# Must match the browser's scheme, host and port, with no trailing slash.
# For a domain, use https://writer.example.com and an HTTPS reverse proxy.
NOVEL_WRITER_PUBLIC_ORIGIN=http://localhost:8080
NOVEL_WRITER_BIND=127.0.0.1
NOVEL_WRITER_HTTP_PORT=8080
NOVEL_WRITER_WEB_USER=author
NOVEL_WRITER_DATABASE_NAME=novel_writer

# Leave unset to use deploy/local/secrets relative to the repository root.
# configure.py writes the actual absolute server path into deployment.env.
# For a custom location, use an absolute path containing database_password and
# web_password. Relative paths are resolved from the root Compose directory.
# NOVEL_WRITER_SECRET_DIR=/absolute/path/to/xs-agent/deploy/local/secrets

# Finish the current response on shutdown. Container grace must be >= this + 60s.
NOVEL_WRITER_GENERATION_SHUTDOWN_GRACE_SECONDS=300
NOVEL_WRITER_STOP_GRACE_PERIOD=360s

# Optional LOCAL DEVELOPMENT settings; these are not forwarded by server Compose.
# Server database URLs, internal tokens and persistent paths are set by entrypoint.py.
# Start the development database with: docker compose -f compose.dev.yaml up -d
# NOVEL_WRITER_ENVIRONMENT=development
# NOVEL_WRITER_HOST=127.0.0.1
# NOVEL_WRITER_PORT=8000
# NOVEL_WRITER_DATABASE_PORT=54329
# NOVEL_WRITER_DATABASE_URL=postgresql+psycopg://novel_writer:novel_writer@127.0.0.1:54329/novel_writer
# NOVEL_WRITER_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# scripts/start.ps1 generates a local token. Never commit a real token.
# NOVEL_WRITER_LOCAL_TOKEN=
# Optional URL: leave commented when unused; an empty value is not a valid URL.
# NOVEL_WRITER_OPENAI_COMPATIBLE_BASE_URL=https://api.example.com/v1
# NOVEL_WRITER_PROVIDER_PROFILES_PATH=data/provider-profiles.json
# auto uses Windows Credential Manager on Windows, private files elsewhere.
# NOVEL_WRITER_CREDENTIAL_BACKEND=auto
# NOVEL_WRITER_CREDENTIALS_ROOT=data/credentials
# Local recovery only; never retries model requests.
# NOVEL_WRITER_GENERATION_RECOVERY_POLL_SECONDS=5

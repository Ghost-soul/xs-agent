NOVEL_WRITER_ENVIRONMENT=development
NOVEL_WRITER_HOST=127.0.0.1
NOVEL_WRITER_PORT=8000
NOVEL_WRITER_DATABASE_PORT=54329
NOVEL_WRITER_DATABASE_URL=postgresql+psycopg://novel_writer:novel_writer@127.0.0.1:54329/novel_writer
NOVEL_WRITER_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Set by scripts/start.ps1. Never commit a real token.
NOVEL_WRITER_LOCAL_TOKEN=


# Optional trusted OpenAI-compatible endpoint; credentials use the configured store.
NOVEL_WRITER_OPENAI_COMPATIBLE_BASE_URL=
# Non-secret third-party profile metadata; API keys are stored separately.
NOVEL_WRITER_PROVIDER_PROFILES_PATH=data/provider-profiles.json
# auto: Windows Credential Manager on Windows, private persistent files elsewhere.
NOVEL_WRITER_CREDENTIAL_BACKEND=auto
# For Docker, mount this directory on a private persistent volume (plaintext, mode 0600).
NOVEL_WRITER_CREDENTIALS_ROOT=data/credentials
# Local response persistence and ownership recovery only; never retries model requests.
NOVEL_WRITER_GENERATION_RECOVERY_POLL_SECONDS=5
# Graceful shutdown finishes the current response; container grace must exceed this by 30s.
NOVEL_WRITER_GENERATION_SHUTDOWN_GRACE_SECONDS=300

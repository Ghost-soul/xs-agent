# Server deployment from GHCR (current Docker Compose plugin, Linux amd64).
# Copy this file to .env beside docker-compose.yml and fill BOTH passwords below.
# Then run: docker compose pull && docker compose up -d --wait
# Database initialization and migrations run automatically inside the containers.
# Keep the real .env private (chmod 600 .env); never commit or share it.

NOVEL_WRITER_STACK=novel-writer-server
# Root docker-compose.yml: use a sha-<commit> tag or digest to pin a release.
NOVEL_WRITER_IMAGE=ghcr.io/ghost-soul/xs-agent:latest

# Must match the browser's scheme, host and port, with no trailing slash.
# For a domain, use https://writer.example.com and an HTTPS reverse proxy.
NOVEL_WRITER_PUBLIC_ORIGIN=http://localhost:8080
NOVEL_WRITER_BIND=127.0.0.1
NOVEL_WRITER_HTTP_PORT=8080
NOVEL_WRITER_WEB_USER=author
NOVEL_WRITER_DATABASE_NAME=novel_writer

# Required: two different random passwords, each at least 24 characters.
# Prefer 32+ letters/digits, or quote special characters with single quotes.
# Compose injects these as secret files; no host-side secret files are required.
NOVEL_WRITER_DATABASE_PASSWORD=
NOVEL_WRITER_WEB_PASSWORD=
# Keep the database password unchanged once its data volume is initialized.
# Model API keys are configured in the web UI after login.

# Finish the current response on shutdown. Container grace must be >= this + 60s.
NOVEL_WRITER_GENERATION_SHUTDOWN_GRACE_SECONDS=300
NOVEL_WRITER_STOP_GRACE_PERIOD=360s

# Keep runtime secrets in .reader.env, never in the image or repository.
READER_IMAGE=ghcr.io/ghost-soul/xs-agent:reader
READER_STACK=novel-reader
READER_BIND=127.0.0.1
READER_HTTP_PORT=8081
READER_PUBLIC_ORIGIN=http://localhost:8081
READER_WEB_USER=reader
# At least 24 characters. Use a separate password from the writing workspace.
READER_WEB_PASSWORD=
# Existing writer stack's Docker network (NOVEL_WRITER_STACK + _default).
READER_DATABASE_NETWORK=novel-writer-server_default
READER_DATABASE_HOST=database
READER_DATABASE_PORT=5432
READER_DATABASE_NAME=novel_writer
READER_DATABASE_USER=novel_reader
READER_DATABASE_PASSWORD=
READER_DATABASE_SSLMODE=prefer

# Deny everything except the application build inputs.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!uv.lock
!src/**/*.py
!migrations/**/*.py
!configs/genre-quality-cards/genres/*.md
!configs/genre-quality-cards/narrative/*.md
!configs/prompt-templates/published.json
!frontend/package.json
!frontend/pnpm-lock.yaml
!frontend/index.html
!frontend/tsconfig*.json
!frontend/vite.config.ts
!frontend/src/**/*.ts
!frontend/src/**/*.tsx
!frontend/src/**/*.css
!frontend/src/**/*.svg
!deploy/__init__.py
!deploy/entrypoint.py
!deploy/web.py
!deploy/healthcheck.py
!deploy/alembic.ini
!deploy/README.md
# Never send local state, even when a new allow rule is added above.
**/.env
**/.env.*
**/local/**
**/data/**
**/credentials/**
**/secrets/**
**/.git/**
**/.runtime/**
**/node_modules/**
**/__pycache__/**
**/*.test.*
**/testSetup.ts
**/*.key
**/*.pem
**/*.log
**/*.dump
**/*.sql
**/*.sqlite*
**/*.db
**/*.zip
**/*.tar*
